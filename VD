<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Valentine Surprise</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --pink-100: #ffe6ef;
      --pink-200: #ffd4e4;
      --pink-400: #ff7db1;
      --pink-500: #ff5f9e;
      --rose-600: #d6336c;
      --wine-700: #9b1d4f;
      --cream: #fff7fb;
      --text: #3b1831;
      --shadow: 0 12px 30px rgba(155, 29, 79, 0.2);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Poppins", sans-serif;
      color: var(--text);
      background: radial-gradient(circle at top, #fff9fc 0%, #ffe6f1 45%, #ffd6e7 100%);
      overflow-x: hidden;
    }

    .hearts {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .heart {
      position: absolute;
      width: 12px;
      height: 12px;
      background: rgba(255, 95, 158, 0.35);
      transform: rotate(45deg);
      animation: floatUp linear infinite;
    }

    .heart::before,
    .heart::after {
      content: "";
      position: absolute;
      width: 12px;
      height: 12px;
      background: inherit;
      border-radius: 50%;
    }

    .heart::before {
      left: -6px;
    }

    .heart::after {
      top: -6px;
    }

    @keyframes floatUp {
      from {
        transform: translateY(115vh) rotate(45deg) scale(0.7);
        opacity: 0;
      }
      10% {
        opacity: 0.8;
      }
      to {
        transform: translateY(-15vh) rotate(45deg) scale(1.1);
        opacity: 0;
      }
    }

    .wrapper {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 2rem 1rem;
    }

    .card {
      width: min(760px, 100%);
      background: rgba(255, 255, 255, 0.86);
      border: 1px solid rgba(214, 51, 108, 0.15);
      backdrop-filter: blur(4px);
      border-radius: 28px;
      box-shadow: var(--shadow);
      padding: clamp(1.5rem, 4vw, 2.8rem);
      text-align: center;
    }

    .pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--pink-100);
      color: var(--wine-700);
      padding: 0.45rem 1rem;
      border-radius: 999px;
      font-size: 0.92rem;
      font-weight: 500;
      margin-bottom: 1rem;
    }

    h1 {
      margin: 0;
      font-family: "Dancing Script", cursive;
      font-size: clamp(2.4rem, 6vw, 4.3rem);
      color: var(--rose-600);
      line-height: 1.1;
    }

    .subtitle {
      margin: 1rem auto 0;
      max-width: 54ch;
      font-size: clamp(1rem, 2.4vw, 1.15rem);
      line-height: 1.7;
      color: #65213f;
    }

    .actions {
      margin-top: 1.8rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.8rem;
    }

    button {
      border: none;
      border-radius: 999px;
      padding: 0.75rem 1.3rem;
      font: inherit;
      font-weight: 600;
      cursor: pointer;
      transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--pink-500), var(--rose-600));
      color: white;
      box-shadow: 0 8px 18px rgba(214, 51, 108, 0.25);
    }

    .btn-secondary {
      background: #fff;
      color: var(--rose-600);
      border: 1px solid var(--pink-200);
    }

    button:hover {
      transform: translateY(-2px);
    }

    #letter {
      margin-top: 1.4rem;
      background: var(--cream);
      border: 1px solid var(--pink-200);
      border-radius: 18px;
      padding: 1rem 1.15rem;
      text-align: left;
      line-height: 1.75;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transform: translateY(8px);
      transition: all 350ms ease;
    }

    #letter.open {
      max-height: 420px;
      opacity: 1;
      transform: translateY(0);
    }

    .countdown {
      margin-top: 1.3rem;
      font-weight: 500;
      color: var(--wine-700);
    }

    .footer-note {
      margin-top: 1.1rem;
      font-size: 0.9rem;
      color: #7f3d5f;
    }

    @media (max-width: 520px) {
      .card {
        border-radius: 22px;
      }

      .actions {
        flex-direction: column;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>
<body>
  <div class="hearts" aria-hidden="true" id="hearts"></div>

  <main class="wrapper">
    <section class="card">
      <span class="pill">💖 Happy Valentine’s Day 💖</span>
      <h1>To My Favorite Person</h1>
      <p class="subtitle" id="subtitle">
        You make ordinary days feel magical. I made this little page just to remind you how deeply loved you are.
      </p>

      <div class="actions">
        <button class="btn-primary" id="revealBtn">Open My Love Letter</button>
        <button class="btn-secondary" id="nextLineBtn">Tell Me Something Sweet</button>
      </div>

      <article id="letter" aria-live="polite">
        Every laugh with you is my favorite sound, every moment with you is my favorite memory in the making.
        Thank you for being my calm, my chaos, and my happiest place all at once. No matter where life takes us,
        I’ll keep choosing you — today, tomorrow, and every day after. ❤️
      </article>

      <p class="countdown" id="countdown"></p>
      <p class="footer-note">Tip: You can personalize the message in <code>index.html</code> before sharing it.</p>
    </section>
  </main>

  <script>
    const sweetLines = [
      "With you, every day feels like Valentine’s Day.",
      "If I had to choose again, I’d choose you in every lifetime.",
      "You are my favorite hello and my hardest goodbye.",
      "Your smile is still my favorite view.",
      "I love you more than words, more than songs, more than stars."
    ];

    const subtitle = document.getElementById("subtitle");
    const nextLineBtn = document.getElementById("nextLineBtn");
    const revealBtn = document.getElementById("revealBtn");
    const letter = document.getElementById("letter");
    const countdown = document.getElementById("countdown");
    const heartsContainer = document.getElementById("hearts");

    let lineIndex = 0;

    nextLineBtn.addEventListener("click", () => {
      lineIndex = (lineIndex + 1) % sweetLines.length;
      subtitle.textContent = sweetLines[lineIndex];
    });

    revealBtn.addEventListener("click", () => {
      letter.classList.toggle("open");
      revealBtn.textContent = letter.classList.contains("open")
        ? "Close Letter"
        : "Open My Love Letter";
    });

    function renderCountdown() {
      const now = new Date();
      const year = now.getMonth() > 1 || (now.getMonth() === 1 && now.getDate() > 14)
        ? now.getFullYear() + 1
        : now.getFullYear();
      const valentine = new Date(year, 1, 14, 0, 0, 0);
      const diff = valentine - now;

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);

      countdown.textContent =
        diff > 0
          ? `⏳ ${days}d ${hours}h ${minutes}m until Valentine’s Day`
          : "💘 It’s Valentine’s Day today!";
    }

    function spawnHearts(count = 26) {
      for (let i = 0; i < count; i++) {
        const heart = document.createElement("span");
        heart.className = "heart";
        heart.style.left = `${Math.random() * 100}%`;
        heart.style.animationDuration = `${7 + Math.random() * 8}s`;
        heart.style.animationDelay = `${Math.random() * 7}s`;
        heart.style.opacity = Math.random().toFixed(2);
        heartsContainer.appendChild(heart);
      }
    }

    renderCountdown();
    spawnHearts();
    setInterval(renderCountdown, 60000);
  </script>
</body>
</html>
